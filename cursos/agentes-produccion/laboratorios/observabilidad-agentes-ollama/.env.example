# Crea .env localmente; no lo subas al repositorio.
# Cloud: usa la URL regional elegida. Local: http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-reemplaza-por-tu-clave
LANGFUSE_SECRET_KEY=sk-lf-reemplaza-por-tu-secreto

# Ollama ofrece una API compatible con OpenAI en local.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
